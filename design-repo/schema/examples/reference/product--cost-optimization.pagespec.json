    {
      "section": "hero.center",
      "variant": "media",
      "content": {
        "eyebrow": "Lattice for cost optimization",
        "title": "Spend less on compute and more on insight.",
        "lead": "Rebuild only what changed, retire what nobody uses and see exactly where your money goes. Lattice gives data teams the visibility and automation to keep warehouse spend in line with the value it creates, without slowing anyone down or adding manual tuning.",
        "primary": {
          "label": "Request your demo",
          "href": "/contact"
        },
        "secondary": {
          "label": "Explore Lattice for cost optimization",
          "href": "/product/lattice"
        },
        "highlights": [
          {
            "title": "Up to 64% savings",
            "body": "Typical reduction in compute time once nightly jobs rebuild only the models whose inputs changed."
          }
        ],
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Warehouse spend falling across six weeks",
          "ref": "/assets/pages/hero/cost-optimization.svg"
        }
      },
      "motion": {
        "pattern": "stroke.draw-on",
        "reducedMotionFallback": "render-final-state"
      },
      "style": {
        "strokeShape": "stroke.s8",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "features.checklist",
      "variant": "split",
      "content": {
        "title": "Warehouse bills grow quietly until someone asks",
        "body": "Most platforms rebuild everything on every run and keep tables nobody queries. Lattice shows where compute goes and cuts the waste automatically.",
        "items": [
          {
            "title": "Rebuild only what changed",
            "body": "State-aware builds compare each run with the last good state, reuse results for models whose inputs did not change and rebuild the rest in dependency order, so nightly jobs finish sooner and cost less without hand-tuned selectors."
          },
          {
            "title": "Find and retire models nobody uses",
            "body": "Usage data shows which models no dashboard, notebook or agent has queried in months, so you can switch them off with confidence."
          }
        ],
        "image": {
          "assetRole": "photo.composite-scene",
          "alt": "An engineer reviewing a run that reused unchanged models",
          "ref": "/assets/pages/split/cost-optimization.svg"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "topPadding": "default",
        "imagePlacement": "right",
        "itemStyle": "headed"
      }
    },
    {
      "section": "features.tabs-light",
      "variant": "default",
      "content": {
        "tabs": [
          {
            "label": "Rebuild only what changed with state-aware builds",
            "body": "Lattice compares each run with the last good state and reuses results for unchanged models, cutting compute on every job. Teams that switch typically see shorter runs in the first week, and the savings grow as projects add more models and more frequent schedules.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Compute minutes per run falling after state-aware builds",
              "ref": "/assets/pages/tabs/light-6.svg"
            }
          },
          {
            "label": "Find the most expensive models",
            "body": "See which models cost the most time and money on every run, how that changes week to week and which teams own them, so you can focus optimization where it actually pays off and show finance exactly where the warehouse budget is going each month.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Run history with one retried run",
              "ref": "/assets/pages/tabs/light-4.svg"
            }
          }
        ]
      },
      "motion": {
        "pattern": "tabs.instant",
        "reducedMotionFallback": "none-needed"
      }
    },
