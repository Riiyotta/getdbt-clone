      "content": {
        "quotes": [
          {
            "quote": "Our compute bill fell in the first month and kept falling. We did not change a single model, we just stopped rebuilding the ones that had not changed, and the time we saved went straight into new work the business had been asking for all year.",
            "person": "Jonah Reyes",
            "role": "VP, Data and Insights",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Orbitly",
              "ref": "/assets/marquee/logo-5.svg"
            }
          }
        ]
      },
