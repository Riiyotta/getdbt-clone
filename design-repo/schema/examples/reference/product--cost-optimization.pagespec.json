    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "See it in action",
        "stories": [
          {
            "name": "Orbitly",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Orbitly",
              "ref": "/assets/marquee/logo-5.svg"
            },
            "headline": "Orbitly cuts warehouse spend while shipping more models",
            "quote": "Our compute bill grew faster than the team. Reusing results for models whose inputs had not changed brought spend down in the first month, and the same project now serves twice as many teams across the company without a single new hire.",
            "person": "Jonah Reyes",
            "role": "VP, Data and Insights",
            "stats": [
              {
                "number": "62%",
                "label": "lower warehouse spend after moving to state-aware builds"
              },
              {
                "number": "2x",
                "label": "as many teams served from one project, with no new hires"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies"
            }
          },
          {
            "name": "Kestrel",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Kestrel",
              "ref": "/assets/marquee/logo-1.svg"
            },
            "headline": "Kestrel halves nightly build time with Lattice",
            "quote": "Our nightly load used to finish after the morning stand-up, so nobody trusted the first dashboards of the day. With state-aware builds only the models that changed are rebuilt, and every number is ready before anyone on the team logs on.",
            "person": "Priya Raman",
            "role": "Head of Analytics Engineering",
            "stats": [
              {
                "number": "52.4%",
                "label": "shorter nightly runs after moving more than 400 production models to state-aware builds"
              },
              {
                "number": "3.2x",
                "label": "more models shipped every sprint once review, testing and documentation lived in one place"
              }
