          ],
          "current": "Lattice launch showcase: the season in review"
        },
        "tag": "On demand",
        "title": "Lattice launch showcase",
        "blocks": [
          {
            "kind": "h3",
            "text": "About the show"
          },
          {
            "kind": "p",
            "text": "***Forty minutes, five launches, live demos.***"
          },
          {
            "kind": "p",
            "text": "*Every season the product team gathers the biggest changes in one place and shows them working against a real project. This time the tour covers the faster core engine, state-aware builds, the context service for assistants and the first public look at charts as code. **You will see each feature run end to end, from a pull request to a production job, with the people who built it explaining the trade-offs.** Stay for the questions at the end, where nothing is off the table.*"
          },
          {
            "kind": "p",
            "text": "The recording is available on demand. Register with the form to watch straight away, and we will also send you the slides, links to the documentation for each feature and an invitation to the follow-up office hours."
          },
          {
            "kind": "accordion",
            "items": [
              {
                "q": "What will we cover?",
                "blocks": [
                  {
                    "kind": "p",
                    "text": "**The running order:**"
                  },
                  {
                    "kind": "ul",
                    "items": [
                      {
                        "text": "**Welcome:** a short look at the roadmap."
                      },
                      {
                        "text": "**Build faster:** the new engine and editor improvements, shown on a project with several thousand models."
                      },
                      {
                        "text": "**Trust every change:** review previews and state-aware builds in a live pull request."
                      },
                      {
                        "text": "**Assistants in practice:** connecting an agent to the context service and checking what it can see."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "kind": "img",
            "image": {
              "assetRole": "figure.article-image",
              "alt": "Launch showcase banner with three demo topics",
              "ref": "/assets/pages/misc/launch-inline.svg"
            }
          }
        ],
        "form": {
          "anchor": "register",
          "fields": [
            {
              "name": "firstname",
              "label": "First name",
              "type": "text",
              "required": true,
              "autoComplete": "given-name"
            },
            {
              "name": "lastname",
              "label": "Last name",
              "type": "text",
              "required": true,
              "autoComplete": "family-name"
            },
            {
              "name": "email",
              "label": "Business email",
              "type": "email",
              "required": true,
              "autoComplete": "email"
            },
            {
              "name": "company",
              "label": "Company name",
              "type": "text",
              "required": true,
              "autoComplete": "organization"
            },
            {
              "name": "role",
              "label": "Which best describes your job?",
              "type": "select",
              "required": true,
              "placeholder": "Choose one",
              "options": [
                "Analytics engineer",
                "Analyst or business intelligence developer",
                "Data engineer",
                "Data scientist or machine learning engineer",
                "Software engineer",
                "Platform, infrastructure or reliability engineer",
                "Head of data, director of data or similar data leadership role",
                "Data team manager",
                "Chief data or analytics officer",
                "Chief technology or information officer",
                "Product manager",
                "Finance, revenue operations or planning",
                "Marketing operations or growth",
                "Sales or customer success",
                "Consultant or partner",
                "Architect",
                "Governance, privacy or compliance",
                "Security",
                "Executive outside the data function",
                "Researcher or academic",
                "Student",
                "Founder",
                "Recruiter",
                "Other"
              ]
            },
            {
              "name": "phone",
              "label": "Phone number",
              "type": "tel",
              "autoComplete": "tel"
            }
          ],
          "submit": "Watch now",
          "consent": "Lattice uses the details you share to reply to this request and, now and then, to send related product news. You may opt out of these emails at any time. To learn how we store and protect personal data, read our [privacy notice](/terms-of-use).",
          "success": "You are registered. A calendar invitation and the joining link will arrive by email shortly."
        }
      },
