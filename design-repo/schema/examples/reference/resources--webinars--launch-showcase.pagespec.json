    {
      "section": "form.form-header",
      "variant": "registration",
      "content": {
        "breadcrumb": {
          "items": [
            {
              "label": "Webinars",
              "href": "/resources/webinars"
            },
            {
              "label": "On demand",
              "href": "/resources/webinars"
