    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "Used by teams who ship daily",
        "body": "See how leading teams turn raw data into decisions daily.",
        "stories": [
          {
            "name": "Meridian Partners",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Meridian Partners",
              "ref": "/assets/marquee/logo-2.svg"
            },
            "headline": "Meridian Partners standardizes reporting across eleven regional desks",
            "summary": "One governed metrics project replaced eleven desk-level spreadsheets, and every quarterly figure now traces back to a reviewed definition.",
            "quote": "Every desk had its own version of assets under management, and reconciling them took a week each quarter. Now one tested definition feeds all eleven desks, and the quarterly close is now a short review meeting instead of a week-long firefight.",
            "person": "Tomas Ekberg",
            "role": "Director of Data Platforms",
            "stats": [
              {
                "number": "11",
                "label": "regional desks reporting from one governed project"
              },
              {
                "number": "4d",
                "label": "saved on every quarterly close, with no manual reconciling"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies/meridian-partners"
