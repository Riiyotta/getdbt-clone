      "content": {
        "badge": "Now available on every plan",
        "title": "One definition for every metric.",
        "lead": "Define metrics once and serve the same numbers to every tool and agent.",
        "primary": {
          "label": "Define a metric",
          "href": "/signup"
        },
        "secondary": {
          "label": "Speak to an expert",
          "href": "/contact"
        },
