            "title": "Certification exams",
            "body": "Show what you know with a proctored exam and a shareable credential that employers recognize."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/globe.svg"
            },
            "title": "A global community",
            "body": "Learn alongside thousands of fellow practitioners in study groups, online forums and friendly local meetups in cities worldwide."
          }
        ]
