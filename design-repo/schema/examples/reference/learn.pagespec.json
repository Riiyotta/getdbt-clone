        "title": "Everything you need to grow your data skills",
        "body": "Whether you write your first SQL query this week or already maintain hundreds of models, Lattice learning resources help you build confident habits and stay current with the platform.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/book.svg"
            },
            "title": "Self-paced courses",
            "body": "Short videos and hands-on exercises that fit around a busy week, available free for everyone."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/team.svg"
            },
            "title": "Live instructor sessions",
            "body": "Join small-group sessions where instructors answer questions and review your work in real time."
          },
