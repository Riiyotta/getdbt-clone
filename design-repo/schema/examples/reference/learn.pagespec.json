    {
      "section": "interactive.course-tabs",
      "variant": "default",
      "content": {
        "anchor": "courses",
        "eyebrow": "Course catalog",
        "title": "Courses for every stage of your journey",
        "body": "Start with the fundamentals, then move on to advanced modeling, testing and deployment. Every course is free and includes a certificate of completion.",
        "cta": {
          "label": "See all courses",
          "href": "/learn"
        },
        "tabs": [
          {
            "label": "Getting started",
            "courses": [
              {
                "image": {
                  "assetRole": "resource.thumbnail",
                  "alt": "",
                  "ref": "/assets/pages/resources/r-1.svg"
                },
                "tag": "Beginner",
                "duration": "3 hours",
                "title": "Lattice fundamentals",
                "body": "Set up a project, connect a warehouse, build your first models and add tests and documentation as you go. Ideal for analysts who already know SQL and want to work like software engineers, with version control, reviews and automated checks on every change.",
                "cta": {
                  "label": "Start course",
                  "href": "/signup"
                }
              },
              {
                "image": {
                  "assetRole": "resource.thumbnail",
                  "alt": "",
                  "ref": "/assets/pages/resources/r-4.svg"
                },
                "tag": "Beginner",
                "duration": "2 hours",
                "title": "Working with sources",
                "body": "Declare raw tables as sources, check their freshness on a schedule and build reliable staging models on top of them, using sample data you can load in minutes.",
                "cta": {
                  "label": "Start course",
                  "href": "/signup"
                }
              }
            ]
          },
          {
            "label": "Advanced modeling",
            "courses": [
              {
                "image": {
                  "assetRole": "resource.thumbnail",
                  "alt": "",
                  "ref": "/assets/pages/resources/r-11.svg"
                },
                "tag": "Advanced",
                "duration": "4 hours",
                "title": "Incremental models",
                "body": "Find out when to rebuild just the rows that arrived or changed since the last run, pick a merge approach that suits your warehouse, and check that logic so late-arriving records never slip past. Includes exercises on merge keys, lookback windows and full-refresh safeguards.",
                "cta": {
                  "label": "Start course",
                  "href": "/signup"
                }
              },
              {
                "image": {
                  "assetRole": "resource.thumbnail",
                  "alt": "",
                  "ref": "/assets/pages/resources/r-8.svg"
                },
                "tag": "Advanced",
