        "title": "Add charts to an existing project with a single command",
        "body": "Install the package, run the setup command and your first chart is ready to preview.",
        "copyLabel": "Copy command",
        "tabs": [
          {
            "label": "Package",
            "command": "lattice add lattice-charts"
          },
          {
            "label": "From source",
            "command": "lattice add ./vendor/charts"
          }
        ]
      },
      "motion": {
        "pattern": "tabs.instant",
        "reducedMotionFallback": "none-needed"
      }
