            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/chart.svg"
            },
            "title": "Charts written in YAML beside your models",
            "body": "Describe each chart next to the model it reads from, with the same review process as any other change. Layouts, filters and colors live in one readable file.",
            "action": {
              "label": "Read the docs",
              "href": "/learn"
            }
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/badge.svg"
            },
            "title": "Visual tests before every merge",
            "body": "Check that every chart still renders and that its totals match the model before a change can merge, so broken visuals never reach the people who rely on them.",
            "action": {
              "label": "See the tests",
              "href": "/learn"
            }
          },
          {
            "icon": {
              "assetRole": "icon.feature",
