      "content": {
        "title": "Unify analytics and AI on Helixa.",
        "lead": "Use Lattice to build governed, tested models on Helixa that serve dashboards, notebooks and machine learning features from one source.",
        "primary": {
          "label": "Book your demo",
          "href": "/contact"
        },
        "secondary": {
          "label": "Start with Lattice + Helixa",
          "href": "/signup"
        },
        "media": {
