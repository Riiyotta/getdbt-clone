    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "Data teams trust Lattice + Helixa",
        "body": "Leading teams use Lattice with Helixa to lower the cost of insight, raise trust in data and ship work faster.",
        "stories": [
          {
            "name": "Basalt Health",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Basalt Health",
              "ref": "/assets/marquee/logo-7.svg"
            },
            "headline": "Basalt Health unifies clinical and operational reporting",
            "summary": "One governed model now feeds clinical and finance reporting, with tests on every load across 24 hospitals.",
            "quote": "Clinical and finance teams were reading different bed counts in the same meeting. One governed model now feeds both, with tests on every load, so the conversation is about patient flow rather than about whose numbers are right this time around.",
            "person": "Dr. Mei Lin",
            "role": "Director, Clinical Informatics",
            "stats": [
              {
                "number": "24",
                "label": "hospitals on one shared model"
              },
              {
                "number": "45%",
                "label": "faster monthly operational reporting"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies/basalt-health"
            }
          },
          {
            "name": "Kestrel",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Kestrel",
              "ref": "/assets/marquee/logo-1.svg"
            },
            "headline": "Kestrel halves nightly build time with Lattice",
            "quote": "Our nightly load used to finish after the morning stand-up, so nobody trusted the first dashboards of the day. With state-aware builds only the models that changed are rebuilt, and every number is ready before anyone on the team logs on.",
            "person": "Priya Raman",
            "role": "Head of Analytics Engineering",
            "stats": [
              {
                "number": "52.4%",
                "label": "shorter nightly runs after moving more than 400 production models to state-aware builds"
              },
              {
                "number": "3.2x",
                "label": "more models shipped every sprint once review, testing and documentation lived in one place"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies/kestrel"
            }
          }
        ]
      },
