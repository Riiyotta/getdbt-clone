    {
      "section": "features.card-grid",
      "variant": "image-card",
      "content": {
        "eyebrow": "Built for Helixa",
        "title": "One modeling layer for all Helixa work.",
        "body": "Helixa brings analytics and machine learning onto one platform. Lattice gives both sides a shared modeling layer with tests, lineage and documentation, so data scientists and analysts stop rebuilding the same logic in parallel, start building on each other’s work and ship features and dashboards from the same reviewed definitions.",
        "cards": [
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-2.svg"
            },
            "title": "Shared features, fewer copies",
            "body": "Model features once and reuse them in dashboards and training pipelines, with tests guarding both.",
            "action": {
              "label": "See how teams share models",
              "href": "/product/mesh"
            }
          },
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-3.svg"
            },
            "title": "Lineage across workloads",
            "body": "Trace a prediction or a chart back to the exact source rows, through every transformation in between, in one lineage graph.",
            "action": {
              "label": "See how lineage works",
              "href": "/product/catalog"
            }
          },
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-4.svg"
            },
            "title": "Production without friction",
            "body": "Promote models through environments with tests at every step and schedule jobs that respect dependencies across projects.",
            "action": {
              "label": "See how deployment works",
              "href": "/product/deploy"
            }
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "headerAlign": "start",
        "paddingTop": "default"
      }
    },
