    {
      "section": "hero.center",
      "variant": "square",
      "content": {
        "title": "Better data for better patient outcomes.",
        "lead": "Healthcare data is sensitive, fragmented and critical to care. Lattice helps you unify, govern and trust it, from the clinic floor to the boardroom and every report between.",
        "primary": {
          "label": "Book a call with our healthcare data team",
          "href": "/contact"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Clinic visits flowing into encounter and capacity models",
          "ref": "/assets/pages/hero/healthcare.svg"
        }
      },
      "motion": {
        "pattern": "stroke.idle",
        "reducedMotionFallback": "none-needed"
      },
      "style": {
        "strokeShape": "stroke.s4",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "title": "Where care and life sciences teams use Lattice",
        "body": "Hospitals, health plans and drug developers juggle records from dozens of systems that rarely agree. Here is how Lattice gives their data teams one governed place to reconcile those records, guard patient privacy and get sound, explainable numbers to clinicians, researchers and executives every single day.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/heart.svg"
            },
            "title": "Clinical and operational reporting",
            "body": "Bring clinical, staffing and financial data together in one tested project, so bed counts, wait times and costs agree in every meeting and every report that leadership relies on to plan care. Owners and tests sit next to each model, so a broken feed is caught before the morning huddle."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/lock.svg"
            },
            "title": "Protect patient privacy at every step",
            "body": "Apply role-based access, masking and audit trails to sensitive patient data, so analysts see only what they need and every query can be accounted for when compliance teams ask. Policies live in code and are reviewed like any other change, so nothing slips through on a busy day."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/flask.svg"
            },
            "title": "Research-ready datasets you can rerun",
            "body": "Build reproducible, documented datasets for research and quality programs, with lineage that shows exactly how every cohort was defined and which source systems contributed. Researchers can rerun a study months later and get the same answer from the same reviewed logic."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/clock.svg"
            },
            "title": "Faster time to insight for every team",
            "body": "Replace manual extracts with scheduled, tested pipelines, so operational dashboards refresh reliably and teams spend their time improving care rather than reconciling spreadsheets. Freshness checks warn owners when a source is late, long before a clinician opens a stale report in the morning."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
