      },
      "style": {
        "background": "white"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "wash-icon",
      "content": {
        "title": "Opening up new data use cases",
        "body": "Beyond reporting, Lattice helps healthcare organizations use data to improve patient flow, outcomes and efficiency.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/gauge.svg"
            },
            "title": "Capacity planning",
            "body": "Forecast demand for beds, staff and equipment from trusted, timely data, so hospitals can plan ahead instead of reacting."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/team.svg"
            },
            "title": "Population health insights",
            "body": "Combine clinical, claims and social data to understand patient populations and target care programs where they will make the greatest difference."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/sparkle.svg"
            },
            "title": "AI with guardrails",
            "body": "Give clinical AI tools governed, documented data so their outputs can be traced, explained and trusted by the clinicians, nurses and analysts who rely on them every day."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "revealTrigger": "scroll",
        "headerAlign": "center",
        "paddingTop": "none",
        "surface": "light",
        "columns": "3",
        "iconSize": "size.icon.32"
      }
    },
    {
      "section": "features.tabs-dark",
      "variant": "default",
      "content": {
        "title": "Improve care and operations with data every team can trust",
        "body": "Lattice brings governance, quality and speed to healthcare data, helping teams protect privacy while getting answers to the people who need them sooner.",
        "tabs": [
          {
            "title": "Governed transformation for sensitive data",
            "body": "Transform clinical and operational data with version control, peer review and automated tests, while access controls and masking keep protected information safe at every step of the pipeline. Every change is reviewed and every measure carries its lineage, so quality teams can answer questions in minutes.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Column-level lineage from raw orders to a revenue model",
              "ref": "/assets/pages/tabs/dark-4.svg"
            }
          },
          {
            "title": "Lineage for every measure you report",
            "body": "Show regulators and quality teams exactly how each measure was calculated, from source system to final report.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Column-level lineage from raw orders to a revenue model",
              "ref": "/assets/pages/tabs/dark-4.svg"
            }
          },
          {
            "title": "Patient privacy built in from the start",
            "body": "Role-based access, masking and audit trails make sure only the right people see sensitive patient data.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Catalog search results with owners and certification",
              "ref": "/assets/pages/tabs/dark-8.svg"
            }
          },
          {
            "title": "Shared definitions across clinical, finance and care teams",
            "body": "Clinical, finance and operations teams use the same tested definitions for every key measure.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Editor suggesting a uniqueness test while a model is written",
              "ref": "/assets/pages/tabs/dark-2.svg"
            }
          },
