    {
      "section": "features.gradient-panel",
      "variant": "text-first",
      "content": {
        "eyebrow": "Build faster",
        "title": "Plain SQL, real software",
        "body": "Every model is a SELECT statement in a file, reviewed in pull requests and checked against the live warehouse schema while you type. Lattice flags a misspelled column, a broken join or a missing grain before anything runs, and compiles one project for each supported warehouse engine.",
        "primary": {
          "label": "Start a new free project",
          "href": "#"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Lattice editor flagging an unknown column while a model is written",
          "ref": "/assets/features/feature-1.svg"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "panelGradient": "gradient.05"
      }
    },
    {
      "section": "features.gradient-panel",
      "variant": "media-first",
      "content": {
        "eyebrow": "Trace context",
        "title": "Follow every field from raw source to dashboard",
        "body": "Open the graph and see dependencies redraw the moment you edit. Color nodes by owner or project layer to spot who depends on whom. Pick a column and the graph traces its origin, every expression that reshapes it, and the dashboards and teams that would notice if it changed overnight.",
        "primary": {
          "label": "Explore lineage",
          "href": "#"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Column-level lineage graph for an intermediate model",
          "ref": "/assets/features/feature-2.svg"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "panelGradient": "gradient.02"
      }
    },
    {
      "section": "features.gradient-panel",
      "variant": "text-first",
      "content": {
        "eyebrow": "Change safely",
        "title": "Rename once. Every reference follows.",
        "body": "Repositories accumulate clutter: obsolete names, duplicated calculations, mysterious joins. Give any column a replacement name and the editor collects every dependent file, presenting a comparison awaiting approval. Nothing changes unannounced.",
        "primary": {
          "label": "See the refactor guide",
          "href": "#"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Rename refactor preview with a downstream build log",
          "ref": "/assets/features/feature-3.svg"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "panelGradient": "gradient.12"
      }
