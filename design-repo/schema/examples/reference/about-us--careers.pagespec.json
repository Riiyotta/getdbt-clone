    {
      "section": "editorial.dark-news-strip",
      "variant": "default",
      "content": {
        "eyebrow": "Life here",
        "title": "Lattice was named a top remote employer for the third year",
        "body": "An independent survey of more than eight thousand remote workers ranked Lattice among the best places to work for distributed teams. Employees pointed to written-first communication, generous learning budgets and managers who protect focus time. We are proud of the result and even prouder that it came directly from our own people.",
        "cta": {
          "label": "Read the full announcement",
          "href": "/press"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "border-card",
      "content": {
        "title": "Why Lattice",
        "body": "We are building the foundation that analytics and AI teams depend on, and we want people who enjoy hard problems, clear writing and helping each other grow. Here is what working at Lattice looks like in practice, beyond the job description.",
        "cards": [
          {
            "title": "Remote from day one",
            "body": "Work from wherever you do your best thinking, with stipends for a home office and a coworking space."
          },
          {
            "title": "Learning budget",
            "body": "Every employee gets an annual budget for courses, books and conferences, plus time set aside to use it."
          },
          {
            "title": "Time to recharge",
            "body": "Flexible paid time off with a minimum we actually encourage, plus a company-wide week off each winter."
          },
          {
            "title": "Real ownership",
            "body": "Small teams own problems end to end, from the first customer interview to the production dashboard."
          },
          {
            "title": "Care for families",
            "body": "Paid parental leave for every parent, plus support for caregivers when life needs more of your time."
          },
          {
            "title": "Meet in person",
            "body": "Teams gather a few times a year for planning, hacking and a lot of shared meals in a new city each time."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
