    {
      "section": "hero.center",
      "variant": "square",
      "content": {
        "title": "Turn plant data into better decisions.",
        "lead": "Sensors, suppliers and systems all produce data at different speeds. Lattice brings it together into tested models, so planners and operators work from the same trusted numbers.",
        "primary": {
          "label": "Book a call with our manufacturing team",
          "href": "/contact"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Line sensor readings flowing into yield and downtime models",
          "ref": "/assets/pages/hero/manufacturing.svg"
        }
      },
      "motion": {
        "pattern": "stroke.idle",
        "reducedMotionFallback": "none-needed"
      },
      "style": {
        "strokeShape": "stroke.s4",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "title": "Where plant data teams use Lattice",
        "body": "Manufacturers depend on accurate, timely data to keep lines running and supply chains moving. These are the ways Lattice helps operations, quality and planning teams turn scattered plant, supplier and sensor data into decisions they can act on with confidence, on every shift and at every site.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/factory.svg"
            },
            "title": "Production and yield reporting",
            "body": "Combine machine, shift and quality data into tested models that show yield, scrap and throughput for every line, so plant managers spot problems early and act before they become expensive. Each metric has an owner and a definition, so every plant reports it in exactly the same way, every week."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/gauge.svg"
            },
            "title": "Predictive maintenance you can trust",
            "body": "Build reliable feature tables from sensor readings and maintenance logs, giving data scientists trusted inputs for models that predict failures before they stop a production line. Tests flag drifting sensors early, so a faulty reading never quietly skews the forecast."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/globe.svg"
            },
            "title": "Supply chain visibility across plants",
            "body": "Bring supplier, stock and freight records into one governed project, so planners can quickly spot late parts and shortages across every plant and region side by side, and act before a missing part stops a line."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/badge.svg"
            },
            "title": "Quality and traceability for every lot",
            "body": "Trace every batch and component back through each process step with lineage and tests, making recalls faster and audits far less painful for every team involved. When a customer asks about a lot, quality teams answer in minutes instead of weeks."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
