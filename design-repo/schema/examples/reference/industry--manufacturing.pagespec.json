      }
    },
    {
      "section": "features.tabs-dark",
      "variant": "default",
      "content": {
        "title": "Run smarter, safer plants with data every team can trust",
        "body": "Lattice brings structure and quality to manufacturing data, connecting plants, suppliers and systems into one reliable foundation for every decision. Operations, quality and planning teams share tested models, so the numbers on the shop floor match the numbers in the boardroom.",
        "tabs": [
          {
            "title": "Tested pipelines from every sensor to every plant dashboard",
            "body": "Transform high-volume sensor and machine data with version control, peer review and automated tests, so every model behind a yield report or a maintenance forecast has been checked before anyone acts on it, and every change carries a clear owner.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Nightly run timeline grouped by project layer",
              "ref": "/assets/pages/tabs/dark-6.svg"
            }
          },
          {
            "title": "Lineage for every batch and supplier",
            "body": "Trace a product back through every process step and supplier to the data it came from.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Column-level lineage from raw orders to a revenue model",
              "ref": "/assets/pages/tabs/dark-4.svg"
            }
          },
          {
            "title": "Governed access across every plant",
            "body": "Control who sees which plant and supplier data, with audit trails for every query.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Catalog search results with owners and certification",
              "ref": "/assets/pages/tabs/dark-8.svg"
            }
          },
          {
            "title": "Shared definitions for yield, uptime and scrap in every plant",
            "body": "Agree on yield, uptime and scrap definitions once, and use them in every plant.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Editor suggesting a uniqueness test while a model is written",
              "ref": "/assets/pages/tabs/dark-2.svg"
            }
          },
          {
            "title": "Scale from one plant to many",
            "body": "Add plants and regions as projects with owners and contracts, without losing consistency.",
            "media": {
