      "content": {
        "title": "Opening up new data use cases",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/bolt.svg"
            },
            "title": "Energy and waste reduction",
            "body": "Track energy use and waste per line and per product, and target improvements where they will save the most money."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/chart.svg"
            },
            "title": "Demand-driven planning across every plant",
            "body": "Connect sales, inventory and production data so planning reflects real demand rather than last year’s spreadsheet and gut feeling."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/sparkle.svg"
            },
            "title": "AI assistants on the factory floor, safely",
            "body": "Give operators AI assistants grounded in governed production data, so their suggestions are explainable and safe to act on."
          }
        ]
