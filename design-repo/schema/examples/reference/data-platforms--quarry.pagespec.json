    },
    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "Data teams trust Lattice + Quarry",
        "body": "Leading teams use Lattice with Quarry to lower the cost of insight, raise trust in data and ship work faster.",
        "stories": [
          {
            "name": "Tidepool",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Tidepool",
              "ref": "/assets/marquee/logo-3.svg"
            },
            "headline": "Tidepool gives product teams self-serve data they can trust",
            "quote": "Product managers wanted answers in hours, not tickets in a queue. Lattice gave them documented, tested models to build on, and our small data team finally spends its time on genuinely new questions instead of re-running old ones each week.",
            "person": "Ana Kowalski",
            "role": "Staff Data Engineer",
            "stats": [
              {
                "number": "70%",
                "label": "fewer ad hoc requests reaching the central data team"
              },
              {
                "number": "140",
                "label": "product dashboards rebuilt on certified, documented models"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies"
            }
          },
          {
            "name": "Orbitly",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Orbitly",
              "ref": "/assets/marquee/logo-5.svg"
            },
            "headline": "Orbitly cuts warehouse spend while shipping more models",
            "quote": "Our compute bill grew faster than the team. Reusing results for models whose inputs had not changed brought spend down in the first month, and the same project now serves twice as many teams across the company without a single new hire.",
            "person": "Jonah Reyes",
            "role": "VP, Data and Insights",
            "stats": [
              {
                "number": "62%",
                "label": "lower warehouse spend after moving to state-aware builds"
              },
              {
                "number": "2x",
                "label": "as many teams served from one project, with no new hires"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies"
            }
          },
          {
            "name": "Ferrocene",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Ferrocene",
              "ref": "/assets/marquee/logo-4.svg"
            },
            "headline": "Ferrocene brings plant and supply data into one tested project",
            "quote": "We were stitching sensor exports and supplier files together by hand before every planning cycle. Now the pipeline is versioned, every join is tested, and planners open a forecast they can trace all the way back to the original source rows.",
            "person": "Lukas Brenner",
            "role": "Manager, Operations Analytics",
            "stats": [
              {
                "number": "9",
                "label": "plants feeding a single, versioned and tested forecast"
              },
              {
                "number": "35%",
                "label": "less time preparing data before each planning cycle"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies"
            }
          }
        ]
