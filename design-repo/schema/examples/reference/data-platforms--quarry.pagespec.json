    {
      "section": "hero.split",
      "variant": "flush",
      "content": {
        "title": "Turn Quarry data into trusted answers.",
        "lead": "Model, test and document your Quarry datasets in one governed project, and serve every team the same reliable numbers at any scale.",
        "primary": {
          "label": "Book your demo",
          "href": "/contact"
        },
        "secondary": {
          "label": "Start with Lattice + Quarry",
          "href": "/signup"
        },
        "media": {
          "assetRole": "photo.composite-scene",
          "alt": "Lattice and Quarry tiles around a data team at work",
          "ref": "/assets/pages/hero/quarry.svg"
        }
      },
      "motion": {
        "pattern": "stroke.draw-on",
        "reducedMotionFallback": "render-final-state"
      },
      "style": {
        "strokeShape": "stroke.s3",
        "strokeGradient": "gradient.01"
      }
