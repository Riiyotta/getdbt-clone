    {
      "section": "features.card-grid",
      "variant": "image-card",
      "content": {
        "eyebrow": "Why Quarry teams",
        "title": "A faster path from raw Quarry tables to decisions people trust.",
        "body": "Quarry handles storage and compute at any scale. Lattice adds tested, versioned and documented models on top.",
        "cards": [
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-7.svg"
            },
            "title": "Governed by design for every team",
            "body": "Contracts, access rules and model versions keep shared datasets stable while every team builds on them at its own pace.",
            "action": {
              "label": "See how governance works",
              "href": "/product/mesh"
            }
          },
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-8.svg"
            },
            "title": "Smarter builds that cost less to run",
            "body": "Rebuild only what changed since the last good run and keep Quarry slot usage predictable as your project grows.",
            "action": {
              "label": "See how state-aware builds work",
              "href": "/product/deploy"
            }
          },
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-9.svg"
            },
            "title": "Ready for assistants and agents today",
            "body": "Descriptions, owners and certified metrics travel with every model, giving assistants and agents context they can actually use, and giving reviewers a clear record of which sources every answer drew on.",
            "action": {
              "label": "See how teams prepare for AI",
              "href": "/product/ai"
            }
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "headerAlign": "start",
        "paddingTop": "default"
      }
    },
    {
      "section": "content.media-split",
      "variant": "text-left",
      "content": {
        "title": "Bring the full modeling lifecycle to Quarry",
        "paragraphs": [
          "Lattice connects natively to Quarry so your team can design, test and ship models in one place, then keep them healthy in production."
        ],
        "bullets": [
          "Compile and check every model against the live Quarry schema",
          "Run tests in pull requests before changes reach production datasets",
          "Schedule state-aware jobs that only rebuild what actually changed"
        ],
        "primary": {
          "label": "Talk to an expert",
          "href": "/contact"
        },
        "tertiary": {
          "label": "Read the docs",
          "href": "/learn"
        },
        "media": {
