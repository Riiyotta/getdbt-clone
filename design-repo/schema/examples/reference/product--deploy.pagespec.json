    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "Used by teams who ship daily",
        "body": "See how leading teams turn raw data into decisions daily.",
        "stories": [
          {
            "name": "Kestrel",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Kestrel",
              "ref": "/assets/marquee/logo-1.svg"
