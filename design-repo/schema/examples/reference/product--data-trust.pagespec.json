    {
      "section": "features.checklist",
      "variant": "grid",
      "content": {
        "title": "What it takes to earn trust in your data",
        "body": "Trust comes from habits that make quality visible: tests on every model, lineage on every column, a named owner for every table and review on every change.",
        "items": [
          {
            "title": "Catch issues before your stakeholders do",
            "body": "Tests and freshness checks run on every build, so broken data is stopped and fixed before it reaches a single dashboard, report or customer-facing metric."
          },
          {
            "title": "Show where every number comes from",
            "body": "Column-level lineage traces each figure back to its source rows, so you can answer “where did this come from?” in seconds."
          },
          {
            "title": "Make ownership visible to everyone",
            "body": "Every model has a named owner and a description, so people know who to ask and teams stop guessing about responsibility."
          },
          {
            "title": "Review every change before it ships",
            "body": "Changes go through pull requests with real data previews, so reviewers see the impact on downstream reports before approving."
          },
          {
            "title": "Agree on one definition of each metric",
            "body": "Metrics are defined once and served everywhere, ending the meetings spent arguing about whose version of revenue is right."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "paddingTop": "default"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "eyebrow": "Why us",
        "title": "Trust is built one tested model at a time, by every team that ships data.",
        "body": "Lattice gives data teams the habits of software engineering, from review to testing to documentation, so the business can rely on their work and the team can spend less time defending it. Every model carries an owner, tests and lineage, and every change is reviewed before it ships.",
        "primary": {
          "label": "Talk to an expert",
          "href": "/contact"
        },
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/badge.svg"
            },
            "title": "Proven quality",
            "body": "Tests on every model and every run catch problems early and record the exact rows that broke each rule for review later by the owner."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/search.svg"
            },
            "title": "Clear lineage",
            "body": "Trace any column from source to dashboard and see exactly what a change will affect before it ships to the production project."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/user.svg"
            },
            "title": "Named owners for every model",
            "body": "Owners and descriptions live next to the code and show up wherever people look for data, from the catalog to the BI tool they use."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/bell.svg"
            },
            "title": "Timely alerts",
            "body": "Failures reach the right owner with the context needed to fix them, often well before anyone downstream notices a problem."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "iconSize": "size.icon.32",
        "headerAlign": "start",
        "paddingTop": "default"
      }
    },
