      "content": {
        "title": "See it in action",
        "stories": [
          {
            "name": "Halcyon",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Halcyon",
              "ref": "/assets/marquee/logo-6.svg"
            },
            "headline": "Halcyon passes its audit with lineage on every regulated figure",
            "summary": "Halcyon put every regulated report on reviewed, versioned and tested models, with lineage from each figure back to its source rows. When the regulator asked for evidence, the team shared a link.",
            "quote": "Auditors asked where each reported figure came from, and for the first time we could simply show them. Every model is versioned and tested, every change is reviewed, and lineage traces each number all the way back to the exact source rows it came from.",
            "person": "Grace Okafor",
            "role": "Chief Data Officer",
            "stats": [
              {
                "number": "0",
                "label": "audit findings on lineage or change control in the last review"
              },
              {
                "number": "100%",
                "label": "of regulated reports built on reviewed, tested models"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies/halcyon"
            }
          },
          {
            "name": "Basalt Health",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Basalt Health",
              "ref": "/assets/marquee/logo-7.svg"
            },
            "headline": "Basalt Health unifies clinical and operational reporting",
            "quote": "Clinical and finance teams were reading different bed counts in the same meeting. One governed model now feeds both, with tests on every load, so the conversation is about patient flow rather than about whose numbers are right this time around.",
            "person": "Dr. Mei Lin",
            "role": "Director, Clinical Informatics",
            "stats": [
