      "content": {
        "title": "Scale data work across teams.",
        "lead": "Split one large project into domains that publish and share safely.",
        "primary": {
          "label": "Explore the mesh",
          "href": "/signup"
        },
        "secondary": {
          "label": "Speak to an expert",
          "href": "/contact"
        },
