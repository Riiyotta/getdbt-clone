    {
      "section": "features.tabs-dark",
      "variant": "default",
      "content": {
        "title": "Run a faster, smarter network on data that every engineering and product team can trust",
        "body": "Lattice brings structure, quality and governance to telecom data at massive scale, giving every team one reliable foundation to build on. Network, product and customer teams share tested models with clear owners, so one change never quietly breaks another report.",
        "tabs": [
          {
            "title": "Tested pipelines for every network event, at any scale",
            "body": "Transform billions of network and usage events with version control, peer review and automated tests, so every model that feeds a capacity plan, a churn score or a regulatory report has been checked before anyone relies on it. Lineage shows how each figure was built, and owners hear about failures before customers notice a thing.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Nightly run timeline grouped by project layer",
              "ref": "/assets/pages/tabs/dark-6.svg"
            }
          },
          {
            "title": "Lineage for every churn metric",
            "body": "Trace churn, revenue and quality metrics back to the events and systems they came from.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Column-level lineage from raw orders to a revenue model",
              "ref": "/assets/pages/tabs/dark-4.svg"
            }
          },
          {
            "title": "Subscriber privacy by design",
            "body": "Mask and restrict sensitive subscriber data while keeping it useful for analytics.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Catalog search results with owners and certification",
              "ref": "/assets/pages/tabs/dark-8.svg"
            }
          },
          {
            "title": "Shared definitions across network, product and finance teams",
            "body": "Network, product and finance teams agree on one definition of every key metric.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Weekly active teams metric with a trend chart",
              "ref": "/assets/pages/tabs/dark-7.svg"
            }
          },
          {
            "title": "Scale across markets",
            "body": "Add new markets and brands as projects with clear owners and contracts.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Visual model canvas joining event sources into a staging model",
              "ref": "/assets/pages/tabs/dark-1.svg"
            }
          }
        ]
      },
      "motion": {
