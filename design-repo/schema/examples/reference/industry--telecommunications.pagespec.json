    {
      "section": "hero.center",
      "variant": "square",
      "content": {
        "title": "Connect every network signal to insight.",
        "lead": "Call records, network events and customer data never stop flowing. Lattice turns them into tested, governed models, so every team can act on the same numbers in time.",
        "primary": {
          "label": "Book a call with our telecom data team",
          "href": "/contact"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Call records flowing into network and churn models",
          "ref": "/assets/pages/hero/telecommunications.svg"
        }
      },
      "motion": {
        "pattern": "stroke.draw-on",
        "reducedMotionFallback": "render-final-state"
      },
      "style": {
        "strokeShape": "stroke.s4",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "title": "Where telecom data teams put Lattice",
        "body": "Telecom operators run some of the largest and fastest data pipelines anywhere. These are the ways Lattice helps network, product and customer teams turn that data into reliable insight while keeping costs and complexity under control, even as event volumes keep doubling year after year.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/signal.svg"
            },
            "title": "Network performance and capacity",
            "body": "Transform network events into tested models for coverage, capacity and quality, so engineering teams see problems early and can prioritize upgrades where customers feel them most. Every metric has an owner and a definition, so regional teams compare like with like when they plan their spend."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/user.svg"
            },
            "title": "Churn prediction and retention",
            "body": "Combine usage, billing and support data into trusted customer models that help teams spot churn risk early and target retention offers where they will actually make a difference. Tests on each source keep a late billing feed from quietly skewing the risk scores that marketing acts on every week."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/dollar.svg"
            },
            "title": "Revenue assurance and billing",
            "body": "Reconcile usage, rating and billing data with automated tests, catching leakage and errors before they reach invoices, financial reports or regulatory filings, and giving finance a clear trail for every adjustment."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/lock.svg"
            },
            "title": "Subscriber privacy and compliance",
            "body": "Mask subscriber details by role, log every query against them, and give regulators a clear record of where personal information flows between systems. Access policies are written in code and reviewed like any other change, so a rushed edit never exposes data."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "iconSize": "size.icon.32",
        "headerAlign": "start",
        "paddingTop": "none"
      }
    },
