    {
      "section": "hero.split",
      "variant": "flush",
      "content": {
        "title": "Get more from Northwind with Lattice.",
        "lead": "Put every Northwind model under Git, wrap it in tests and generated docs, and let analysts ship trustworthy tables in a fraction of the time.",
        "primary": {
          "label": "Book your demo",
          "href": "/contact"
        },
        "secondary": {
          "label": "Start with Lattice + Northwind",
          "href": "/signup"
        },
        "media": {
          "assetRole": "photo.composite-scene",
          "alt": "Lattice and Northwind tiles around a data team at work",
          "ref": "/assets/pages/hero/northwind.svg"
        }
      },
      "motion": {
        "pattern": "stroke.draw-on",
        "reducedMotionFallback": "render-final-state"
      },
      "style": {
        "strokeShape": "stroke.s3",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "image-card",
      "content": {
        "eyebrow": "Northwind",
        "title": "Everything your team needs to build on Northwind with confidence.",
        "body": "Northwind stores and scales your data. Lattice gives the people who model it one shared, tested project.",
        "cards": [
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-4.svg"
            },
            "title": "Fewer broken reports",
            "body": "Tests on every model catch null keys, duplicate rows and late data before they reach a dashboard, with alerts routed straight to the owner of each model and the failing rows attached.",
            "action": {
              "label": "See how teams catch issues early",
              "href": "/product/test-and-observe"
            }
          },
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-5.svg"
            },
            "title": "Spend that tracks value",
            "body": "State-aware builds reuse unchanged models and skip redundant work, so Northwind compute goes to the queries that matter most.",
            "action": {
              "label": "See how Orbitly cut its spend",
              "href": "/product/cost-optimization"
            }
          },
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-6.svg"
            },
            "title": "Onboard analysts faster",
            "body": "Documentation and lineage are generated from the project, so new analysts can find and trust the right model in their first week.",
            "action": {
              "label": "See how the catalog helps teams",
              "href": "/product/catalog"
            }
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "headerAlign": "start",
        "paddingTop": "default"
      }
    },
    {
      "section": "content.statement",
      "variant": "video",
      "content": {
        "title": "Lattice and Northwind work together from day one.",
        "body": "Connect Lattice to Northwind in minutes, then build, test and deploy models with the warehouse features your team already relies on, from workload isolation to fine-grained access controls. Watch the short tour below to see a first project go from raw tables to tested models.",
        "video": {
          "assetRole": "video.poster",
          "alt": "Video: a ten-minute tour of the integration",
          "ref": "/assets/pages/misc/poster-1.svg"
        }
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-needed"
      }
    },
    {
      "section": "cta.gradient-card",
