      "content": {
        "title": "What Lattice can do on Northwind.",
        "body": "See what changes when every model ships with tests, an owner and lineage from day one.",
        "primary": {
          "label": "Explore Lattice",
          "href": "/product/lattice"
        }
      },
      "motion": {
