    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "Data teams trust Lattice + Northwind",
        "body": "Leading teams use Lattice with Northwind to lower the cost of insight, raise trust in data and ship work faster.",
        "stories": [
          {
            "name": "Meridian Partners",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Meridian Partners",
              "ref": "/assets/marquee/logo-2.svg"
            },
            "headline": "Meridian Partners standardizes reporting across eleven regional desks",
            "quote": "Every desk had its own version of assets under management. Now one tested definition feeds all eleven desks, and the quarterly close is a short review meeting instead of a week of firefighting.",
            "person": "Tomas Ekberg",
            "role": "Director of Data Platforms",
            "stats": [
              {
                "number": "Weeks to minutes",
                "label": "to close the quarterly books"
              },
              {
                "number": "11",
                "label": "regional desks reporting from one governed project"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies/meridian-partners"
            }
          },
          {
            "name": "Kestrel",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Kestrel",
              "ref": "/assets/marquee/logo-1.svg"
            },
            "headline": "Kestrel halves nightly build time with Lattice",
            "quote": "Our nightly load used to finish after the morning stand-up, so nobody trusted the first dashboards of the day. With state-aware builds only the models that changed are rebuilt, and every number is ready before anyone on the team logs on.",
            "person": "Priya Raman",
            "role": "Head of Analytics Engineering",
            "stats": [
              {
                "number": "52.4%",
                "label": "shorter nightly runs after moving more than 400 production models to state-aware builds"
              },
              {
                "number": "3.2x",
                "label": "more models shipped every sprint once review, testing and documentation lived in one place"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies/kestrel"
            }
          },
          {
            "name": "Fernway",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Fernway",
              "ref": "/assets/marquee/logo-8.svg"
            },
            "headline": "Fernway moves from scripts to a governed, tested project",
            "quote": "We had years of scheduled scripts that only their authors understood. Rebuilding them as Lattice models gave us documentation, tests and reviews for free, and new analysts now contribute in their very first week instead of their third month.",
            "person": "Jordan Ellis",
            "role": "Data Team Lead",
            "stats": [
              {
                "number": "1 wk",
                "label": "for a new analyst to ship a first reviewed, tested model into the production project"
              },
              {
                "number": "600",
                "label": "legacy scripts retired and rebuilt as documented, tested models with clear owners"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies"
            }
          }
        ]
