    {
      "section": "interactive.faq-accordion",
      "variant": "default",
      "content": {
        "title": "Security at a glance",
        "body": "Here are answers to the questions security reviewers ask us most often. If you need something more detailed, our team can share documentation and walk through your questionnaire with you.",
        "items": [
          {
            "q": "Where is customer metadata hosted?",
            "a": "The hosted platform runs in multiple regions across North America, Europe and the Asia Pacific region. You choose a region when your account is created, and your project metadata stays there."
          },
          {
            "q": "How is data encrypted?",
            "a": "All traffic uses modern transport encryption, and stored metadata, logs and credentials are encrypted at rest with keys managed in a dedicated key service."
          },
          {
            "q": "Do you support single sign-on?",
            "a": "Yes. Enterprise plans support single sign-on through standard identity protocols, along with automated user provisioning and removal."
          },
          {
            "q": "Can we restrict access by role?",
            "a": "Role-based permissions let administrators decide who can view, develop, deploy or administer each project and environment."
          },
          {
            "q": "Do you offer private connectivity?",
            "a": "Enterprise plans can connect to supported warehouses over private networking so that traffic never crosses the public internet."
          },
          {
            "q": "How are credentials stored?",
            "a": "Warehouse credentials are encrypted, scoped to the minimum permissions needed, and never shown again after they are saved."
          },
          {
            "q": "How do you test your own security?",
            "a": "Independent testers assess the platform at least once a year, and we run a responsible disclosure program for outside researchers."
          },
          {
            "q": "What happens during an incident?",
            "a": "We follow a documented response plan, notify affected customers promptly, and publish updates on our [status page](/report-a-problem)."
          },
          {
            "q": "Are audit logs available?",
            "a": "Yes. Administrators can review and export audit logs that record sign-ins, permission changes, deployments and configuration updates."
          },
          {
            "q": "How long do you retain run logs?",
            "a": "Run logs and artifacts are retained according to your plan, and administrators can request earlier deletion at any time."
          },
          {
            "q": "How do we report a vulnerability?",
            "a": "Please use our [reporting form](/report-a-problem) and our security team will respond within two business days."
          }
        ]
      },
      "motion": {
        "pattern": "accordion.instant",
        "reducedMotionFallback": "none-needed"
      }
