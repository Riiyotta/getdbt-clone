    {
      "section": "hero.center",
      "variant": "media",
      "content": {
        "title": "Give every agent the right context.",
        "lead": "Ground assistants and agents in governed, tested and documented data, so every answer they give can be traced back to definitions your team owns.",
        "primary": {
          "label": "Request your demo",
          "href": "/contact"
        },
        "secondary": {
          "label": "Explore Lattice for AI workflows",
          "href": "/product/lattice"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "An assistant prompt answered with SQL built on certified models",
          "ref": "/assets/pages/hero/ai.svg"
        }
      },
      "motion": {
        "pattern": "stroke.draw-on",
        "reducedMotionFallback": "render-final-state"
      },
      "style": {
        "strokeShape": "stroke.s8",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "features.checklist",
      "variant": "split",
      "content": {
        "title": "AI is only as good as the data and context you give it to work with",
        "body": "Models prompted on undocumented tables produce confident answers nobody can verify. Lattice gives every assistant and agent the same tested models, descriptions and certified metrics your analysts use.",
        "items": [
          {
            "title": "Certified models instead of raw tables"
          },
          {
            "title": "Descriptions and owners on every column"
          },
          {
            "title": "Metrics defined once and served everywhere"
          }
        ],
        "image": {
          "assetRole": "photo.composite-scene",
          "alt": "An analyst reviewing model context prepared for an assistant",
          "ref": "/assets/pages/split/ai.svg"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "topPadding": "none",
        "imagePlacement": "right",
        "itemStyle": "headed"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "eyebrow": "Why us",
        "title": "Build AI on a foundation you can trust.",
        "body": "Lattice brings the discipline of software engineering to the data behind your AI, from version control and tests to documentation and access controls, so every answer can be traced and explained.",
        "primary": {
          "label": "Talk to an expert",
          "href": "/contact"
        },
        "tertiary": {
          "label": "Explore Lattice for AI workflows",
          "href": "/product/lattice"
        },
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/sparkle.svg"
            },
            "title": "Context that travels with every model",
            "body": "Descriptions, owners and tests ship with every model, so AI tools always read the latest context, not a stale copy from last quarter."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/target.svg"
            },
            "title": "Consistent answers across every tool and team",
            "body": "Certified metrics give assistants one definition of each number, matching the dashboards leaders already use to run the business."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/lock.svg"
            },
            "title": "Governed access for people and agents alike",
            "body": "Access rules apply to agents exactly as they do to people, so sensitive data stays where it belongs and every request is logged for review."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/branch.svg"
            },
            "title": "Traceable outputs, every time",
            "body": "Lineage links every generated answer back to the models and source rows it was built from, so reviewers can check it."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "revealTrigger": "scroll",
        "headerAlign": "start",
        "paddingTop": "default",
        "surface": "light",
        "columns": "4",
        "iconSize": "size.icon.32"
      }
    },
    {
      "section": "features.tabs-light",
      "variant": "default",
      "content": {
        "tabs": [
          {
            "label": "AI copilot",
            "lead": "Draft models from a plain-language request.",
            "body": "The assistant writes SQL, tests and documentation grounded in your project, ready for review like any other change, and explains each choice it made.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Plain-language request turned into a compiled model",
              "ref": "/assets/pages/tabs/ai-1.svg"
            }
          },
          {
            "label": "Canvas",
            "lead": "Let more people build with guardrails.",
            "body": "Business users assemble models visually while Lattice keeps the generated code tested and reviewable.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Visual flow joining two staging tables and adding aggregations",
              "ref": "/assets/pages/tabs/ai-2.svg"
            }
          },
          {
            "label": "Catalog",
            "lead": "Expose context to every agent you run.",
            "body": "Descriptions, owners and certification flow from the catalog to the AI tools that query your data.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Catalog entry with column descriptions and an owner",
              "ref": "/assets/pages/tabs/ai-3.svg"
            }
          },
          {
            "label": "Metrics",
            "lead": "Answer with definitions, not guesses.",
            "body": "Agents request certified metrics by name, so their numbers match the reports your leadership already trusts.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Metric definition next to its monthly chart",
              "ref": "/assets/pages/tabs/ai-4.svg"
            }
          }
        ]
      },
