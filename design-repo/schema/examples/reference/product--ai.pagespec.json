    {
      "section": "content.media-split",
      "variant": "video",
      "content": {
        "eyebrow": "Watch: AI-ready data in practice",
        "title": "See how teams get projects ready for agents",
        "paragraphs": [
          "In this short walkthrough, a data team takes an existing project and makes it ready for AI. They add descriptions where they matter, certify the models agents should use, define key metrics once and connect an assistant, then compare its answers before and after the change."
        ],
        "media": {
          "assetRole": "video.poster",
          "alt": "Video: building an assistant-ready project",
          "ref": "/assets/pages/misc/poster-2.svg"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "columns": "6/6",
        "topPadding": "default"
      }
    },
    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "See it in action",
        "stories": [
          {
            "name": "Orbitly",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Orbitly",
              "ref": "/assets/marquee/logo-5.svg"
            },
            "headline": "Orbitly cuts warehouse spend while shipping more models",
