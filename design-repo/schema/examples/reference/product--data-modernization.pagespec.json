    {
      "section": "hero.center",
      "variant": "media",
      "content": {
        "eyebrow": "Lattice for legacy migrations",
        "title": "Trade brittle jobs for models that can grow.",
        "lead": "New software is half the story. The rest is how your team works with its data.",
        "primary": {
          "label": "Request your demo",
          "href": "/contact"
        },
        "secondary": {
          "label": "See how a typical Lattice migration runs",
          "href": "/product/lattice"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "A legacy job migrated into tested Lattice models",
          "ref": "/assets/pages/hero/data-modernization.svg"
        }
      },
      "motion": {
        "pattern": "stroke.draw-on",
        "reducedMotionFallback": "render-final-state"
      },
      "style": {
        "strokeShape": "stroke.s8",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "content.statement",
      "variant": "plain",
      "content": {
        "title": "Untangle the logic buried inside years of one-off pipeline code",
        "body": "When rules live in stored procedures and cron scripts nobody remembers writing, analysts stop trusting the numbers, AI agents miss the intent, and small changes become forensic work."
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-needed"
      }
    },
    {
      "section": "features.checklist",
      "variant": "columns",
      "content": {
        "items": [
          {
            "title": "Write models that outlive today’s tooling",
            "body": "Instead of nursing hand-rolled ETL jobs that snap whenever a source shifts, your team writes plain SQL models that run in the warehouse, with editing, testing and scheduling in one place."
          },
          {
            "title": "Ship data changes in days, not quarters",
            "body": "Small reviewed pull requests replace big-bang releases, so models follow pricing, product and org changes within the same sprint."
          },
          {
            "title": "Analysts and engineers in one project",
            "body": "Analysts propose edits on a branch and preview results before merging, while engineers set permissions and required checks, so a risky change gets stopped well before it ever lands in your production."
          },
          {
            "title": "Define each metric once, then reference it",
            "body": "Write revenue, churn or active customer once and point to it everywhere. One fix flows to every dashboard, and no two groups compute it two ways."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "paddingTop": "none"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "eyebrow": "Results",
        "title": "What changes once the old stack is retired.",
        "body": "A migration is a chance to fix habits, not just hardware. On Lattice, logic sits in version control, gets tested on each change and documents itself, so the new platform stays tidy well after launch day.",
        "primary": {
          "label": "Plan your migration",
          "href": "/contact"
        },
        "tertiary": {
          "label": "See how a typical Lattice migration runs",
          "href": "/product/lattice"
        },
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/cloud.svg"
            },
            "title": "Go cloud-native",
            "body": "Shift jobs off on-premise schedulers onto hosted runs that scale with demand and leave no servers to patch."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/branch.svg"
            },
            "title": "See every dependency",
            "body": "Column-level lineage shows which reports would break before a source table is ever touched."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/coin.svg"
            },
            "title": "Pay for less compute",
            "body": "Incremental and state-aware runs rebuild only what changed, so warehouse credits go further each month."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/badge.svg"
            },
            "title": "Catch bad rows early",
            "body": "Checks on keys, freshness and accepted values run with every build, so broken or missing rows never reach a chart, a report or an LLM."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "iconSize": "size.icon.32",
        "headerAlign": "start",
        "paddingTop": "default"
      }
    },
    {
      "section": "features.tabs-light",
      "variant": "default",
      "content": {
        "tabs": [
          {
            "label": "Drag and drop",
            "body": "People who don’t write SQL can still build governed models by wiring sources, joins and filters together on a canvas.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Visual flow joining two staging tables and adding aggregations",
              "ref": "/assets/pages/tabs/light-1.svg"
            }
          },
          {
            "label": "AI copilot",
            "body": "Type what you need in one sentence and get working SQL with tests and docs already filled in to match your style guide.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Plain-language request turned into a compiled model",
              "ref": "/assets/pages/tabs/light-2.svg"
            }
          },
          {
            "label": "Explorer",
            "body": "Search any model to see who owns it, when it last refreshed and which dashboards rely on it, all kept current for you.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Catalog entry with column descriptions and an owner",
              "ref": "/assets/pages/tabs/light-3.svg"
            }
          }
        ]
