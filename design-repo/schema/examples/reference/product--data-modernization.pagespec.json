    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "Migration stories",
        "stories": [
          {
            "name": "Fernway",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Fernway",
              "ref": "/assets/marquee/logo-8.svg"
            },
            "headline": "Fernway moves from scripts to a governed, tested project",
            "quote": "We had years of scheduled scripts that only their authors understood. Rebuilding them as Lattice models gave us docs, tests and reviews for free, and new analysts now ship in week one.",
            "person": "Jordan Ellis",
            "role": "Data Team Lead, Reporting and Analytics Platform",
            "stats": [
              {
                "number": "1 wk",
                "label": "for a new analyst to ship a first reviewed, tested model"
              },
              {
                "number": "600",
                "label": "legacy scripts retired and rebuilt as tested, owned models"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies"
            }
          },
          {
            "name": "Meridian Partners",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Meridian Partners",
              "ref": "/assets/marquee/logo-2.svg"
            },
            "headline": "Meridian Partners standardizes reporting across eleven regional desks",
            "quote": "Every desk had its own version of assets under management, and reconciling them took a week each quarter. Now one tested definition feeds all eleven desks, and the quarterly close is now a short review meeting instead of a week-long firefight.",
