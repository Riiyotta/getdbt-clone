    {
      "section": "hero.center",
      "variant": "square",
      "content": {
        "title": "Power reliable decisions with trusted data.",
        "lead": "Grid, meter and asset data arrive at enormous volume and speed. Lattice helps utilities transform, govern and trust it, from the substation to the regulator and the customer bill.",
        "primary": {
          "label": "Book a call with our energy data team",
          "href": "/contact"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Meter reads flowing into load and outage models",
          "ref": "/assets/pages/hero/energy-utilities.svg"
        }
      },
      "motion": {
        "pattern": "stroke.idle",
        "reducedMotionFallback": "none-needed"
      },
      "style": {
        "strokeShape": "stroke.s4",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "title": "Where energy and utility teams use Lattice",
        "body": "Utilities and energy companies face rising demand, ageing assets and strict oversight all at once. These are the ways Lattice helps them turn high-volume operational data into reliable reporting, better planning and faster responses to change, from the control room to the regulator and the customer.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/bolt.svg"
            },
            "title": "Load and outage reporting on time",
            "body": "Turn meter and grid events into tested models for load, outages and reliability metrics, so operations and regulatory reports always agree and are ready on time every reporting period. Owners are alerted the moment a feed is late, long before anyone downstream relies on it."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/gauge.svg"
            },
            "title": "Asset performance and planning",
            "body": "Combine sensor, maintenance and inspection data into a trusted view of every asset, helping teams plan replacements and repairs before failures disrupt service to customers. Lineage shows how each health score was built, so engineers can challenge it with confidence."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/clipboard.svg"
            },
            "title": "Regulatory reporting without the scramble",
            "body": "Produce regulator-ready figures from versioned, reviewed models with full lineage, so every submitted number can be explained and reproduced on request at any time. Reviews happen in pull requests, leaving a clear record of who approved what and when."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/globe.svg"
            },
            "title": "Renewables integration at grid scale",
            "body": "Model generation forecasts and grid balancing data in one governed project, so planners can integrate renewable sources without losing sight of reliability. Tests on weather and output feeds catch gaps early, before they distort the forecast the control room uses."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
