        "quotes": [
          {
            "quote": "Our regulatory submissions come straight from reviewed models now, every figure can be reproduced in minutes when asked, and the team spends its time improving forecasts instead of rebuilding last quarter’s numbers.",
            "person": "Tomas Ekberg",
            "role": "Director of Data Platforms",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Meridian Partners",
              "ref": "/assets/marquee/logo-2.svg"
            }
          }
        ]
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-needed"
      },
      "style": {
        "background": "white"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "wash-icon",
      "content": {
        "title": "Opening up new data use cases",
        "body": "Beyond compliance, Lattice helps utilities use data to plan the grid, serve customers and cut operating costs.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/chart.svg"
            },
            "title": "Demand forecasting",
            "body": "Build reliable forecasts from trusted historical load, weather and customer data, refreshed on schedule and tested on every run, so planners always work from the latest numbers and can explain each assumption."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/user.svg"
            },
            "title": "Customer insights",
            "body": "Understand usage patterns and payment behavior across customer segments to design fairer tariffs and better support programs."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/sparkle.svg"
            },
            "title": "AI for grid operations",
            "body": "Ground AI tools in governed operational data, so recommendations for dispatch and maintenance can be traced, explained and trusted by the crews who act on them."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "revealTrigger": "scroll",
        "headerAlign": "center",
        "paddingTop": "none",
        "surface": "light",
        "columns": "3",
        "iconSize": "size.icon.32"
      }
    },
    {
      "section": "features.tabs-dark",
      "variant": "default",
      "content": {
        "title": "Keep the lights on with data your whole team can trust",
        "body": "Lattice brings quality, governance and speed to energy data, giving operations, planning and regulatory teams one trusted foundation to work from.",
        "tabs": [
          {
            "title": "Tested pipelines for high-volume meter and grid data",
            "body": "Transform meter reads and grid events with version control and automated tests, so load, outage and reliability figures are checked before they ever reach operators, planners, finance teams or regulators.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Nightly run timeline grouped by project layer",
              "ref": "/assets/pages/tabs/dark-6.svg"
            }
          },
          {
            "title": "Lineage for every figure you submit",
            "body": "Show exactly how every submitted figure was produced, from source system to final report.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Column-level lineage from raw orders to a revenue model",
              "ref": "/assets/pages/tabs/dark-4.svg"
            }
          },
          {
            "title": "Secure access to grid and asset data",
            "body": "Grid and asset records are restricted by role, and every read and write is fully logged.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Catalog search results with owners and certification",
              "ref": "/assets/pages/tabs/dark-8.svg"
            }
          },
          {
            "title": "Shared definitions across operations, finance and regulatory teams",
            "body": "Operations, finance and regulatory teams use the same tested definitions for every metric.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Weekly active teams metric with a trend chart",
              "ref": "/assets/pages/tabs/dark-7.svg"
            }
          },
          {
            "title": "Scale with growing data volumes",
            "body": "Handle more meters, sensors and sources without slowing down builds or losing control.",
