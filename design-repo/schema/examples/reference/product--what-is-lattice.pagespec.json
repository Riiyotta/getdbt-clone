    {
      "section": "hero.center",
      "variant": "poster",
      "content": {
        "eyebrow": "Why Lattice",
        "title": "The dependable way to model your data.",
        "lead": "Lattice turns scattered SQL into a shared, versioned project by borrowing the habits of software engineering. A fast engine compiles and runs every model, so analysts, engineers and agents can build on the same trusted work.",
        "primary": {
          "label": "Get Lattice",
          "href": "/signup"
        },
        "secondary": {
          "label": "See the hosted platform",
          "href": "/product/lattice"
        },
        "poster": {
          "assetRole": "video.poster",
          "alt": "Video: a model compiled from two staging tables, with its tests passing",
          "ref": "/assets/pages/illus/what-is.svg"
        }
      },
      "motion": {
        "pattern": "stroke.draw-on",
        "reducedMotionFallback": "render-final-state"
      },
      "style": {
        "strokeShape": "stroke.s10",
        "strokeGradient": "gradient.01"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "wash-icon",
      "content": {
        "eyebrow": "What sets the engine apart",
        "title": "Turn raw tables into products people use.",
        "body": "Ship dependable data products for reporting, operations and AI agents.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/shield.svg"
            },
            "title": "Reliable from day one",
            "body": "Every model is versioned, reviewed and tested before it reaches production. Problems surface in the editor or in review, not in a meeting with your stakeholders the following week."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/layers.svg"
            },
            "title": "Open at every layer",
            "body": "Plain SQL and YAML in a git repository, running on the data platform you already pay for. Develop locally or in the browser, and take it anywhere."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/bolt.svg"
            },
            "title": "Quick to compile, cheap to run",
            "body": "Large projects compile in seconds, and each run touches only the models that moved, so the warehouse burns fewer credits."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "revealTrigger": "scroll",
        "headerAlign": "start",
        "paddingTop": "default",
        "surface": "light",
        "columns": "3",
        "iconSize": "size.icon.56"
      }
    },
    {
      "section": "features.tabs-dark",
      "variant": "default",
      "content": {
        "title": "Everything you need to ship data work.",
        "tabs": [
          {
            "title": "Models written in plain SQL",
            "body": "Write each transformation as a plain select statement. Lattice works out the order to build them in, creates the tables and views, and keeps every single dependency straight for you.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Visual model canvas joining event sources into a staging model",
              "ref": "/assets/pages/tabs/dark-1.svg"
            }
          },
          {
            "title": "Tests beside every model",
            "body": "Declare the rules your data must follow next to the models that produce it. Checks run on every build, so broken joins and missing keys are caught before anyone sees them.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Editor suggesting a uniqueness test while a model is written",
              "ref": "/assets/pages/tabs/dark-2.svg"
            }
          },
          {
            "title": "Documentation that writes itself",
            "body": "Descriptions, owners and column details live in the project and publish to a searchable site, complete with a lineage graph that shows where each number really comes from.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Check results for the last 24 hours with a pass-rate ring",
              "ref": "/assets/pages/tabs/dark-3.svg"
            }
          },
          {
            "title": "Reusable macros and packages",
            "body": "Package common logic once and share it across projects, or install packages from the community hub to skip writing the same date spine or pivot for the hundredth time.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Column-level lineage from raw orders to a revenue model",
              "ref": "/assets/pages/tabs/dark-4.svg"
            }
          },
          {
            "title": "Builds that know what changed",
            "body": "State-aware runs compare your project with the last successful build and rebuild only the models whose code or inputs moved, which keeps pipelines quick and compute bills calm.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Nightly run timeline grouped by project layer",
              "ref": "/assets/pages/tabs/dark-6.svg"
            }
          }
        ]
      },
      "motion": {
        "pattern": "tabs.instant",
        "reducedMotionFallback": "none-needed",
        "additional": [
          {
            "pattern": "stroke.draw-on",
            "reducedMotionFallback": "render-final-state"
          }
        ]
      },
      "style": {
