    {
      "section": "interactive.install-tabs",
      "variant": "default",
      "content": {
        "eyebrow": "Set it up in under a minute",
        "body": "Install the assistant with your package manager, then connect it to a project in your editor. [Read the guide](/learn)",
        "copyLabel": "Copy command",
        "tabs": [
          {
            "label": "Package app",
            "command": "lattice-pkg install lattice-assistant --channel stable && lattice-assistant init --here"
          },
          {
            "label": "Script",
            "command": "curl -fsSL https://install.lattice.example/assistant.sh | sh -s -- --channel stable"
          }
        ]
      },
      "motion": {
        "pattern": "tabs.instant",
        "reducedMotionFallback": "none-needed"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "border-card",
      "content": {
        "title": "Built to work the way analytics engineers already work every day",
        "body": "The assistant reads your models, tests, documentation and lineage, then helps you write, fix and explain code without leaving your editor. Every suggestion is a normal change you can review.",
        "primary": {
          "label": "Install the assistant",
          "href": "/signup"
        },
        "tertiary": {
          "label": "Read the docs",
          "href": "/learn"
        },
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/sparkle.svg"
            },
            "title": "Draft new models from a plain request",
            "body": "Explain the table you want in everyday words and receive a draft that respects your naming and layering habits, with clear comments wherever it made an assumption you should check."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/badge.svg"
            },
            "title": "Write the tests you would have written",
            "body": "Suggests uniqueness, relationship and accepted-value checks based on the columns and joins in each model, and explains why each check matters."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/book.svg"
            },
            "title": "Document every model as you go",
            "body": "Generates descriptions for models and columns, ready to edit and commit alongside the code, in the vocabulary your project already uses."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/search.svg"
            },
            "title": "Explain any model in seconds",
            "body": "Ask why a number looks the way it does and get an answer that walks the lineage back to the sources."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/bolt.svg"
            },
            "title": "Fix failing builds before anyone notices",
            "body": "Reads the error, finds the likely cause in your project and proposes a fix you can review and apply, even when the cause sits upstream in another model."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/lock.svg"
            },
            "title": "Respect the permissions you already set",
            "body": "Works only with the projects and environments you can already access, logs every action it takes, and can be limited to development environments."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately",
        "additional": [
          {
            "pattern": "stroke.draw-on",
            "reducedMotionFallback": "render-final-state"
          }
        ]
      },
      "style": {
        "strokeShape": "stroke.s4",
        "strokeGradient": "gradient.05",
        "revealTrigger": "scroll",
        "headerAlign": "start",
        "paddingTop": "default",
        "surface": "light",
        "columns": "3",
        "iconSize": "size.icon.32",
        "background": "white"
      }
    },
    {
      "section": "cta.gradient-card",
      "variant": "default",
      "content": {
        "title": "Try the assistant on your own project",
        "body": "Install it in a minute, point it at an existing project and ask it to document a model or write a test. Most people see a useful suggestion within the first five minutes, and every change it makes waits for your review.",
        "primary": {
          "label": "Install now",
          "href": "/signup"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      }
    },
    {
      "section": "features.tabs-dark",
      "variant": "default",
      "content": {
        "eyebrow": "Inside your editor",
        "title": "Help that appears exactly where you are already working",
        "body": "Suggestions appear inline, in a side panel or in the terminal, depending on how you like to work each day.",
        "tabs": [
          {
            "title": "Inline suggestions",
            "body": "As you type, the assistant proposes the next lines of a model based on its upstream sources, your conventions and similar models elsewhere in the project. Accept it with one key, or keep typing to ignore it.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Editor with an inline model suggestion",
              "ref": "/assets/features/feature-1.svg"
            }
          },
          {
            "title": "Chat beside your code",
            "body": "Open the side panel to ask questions about the project, request a refactor across several files or get an explanation of an unfamiliar macro. Every change it proposes shows up as a diff you can review line by line before anything is written to disk.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Side panel chat proposing a refactor",
              "ref": "/assets/features/feature-2.svg"
            }
          },
          {
            "title": "Terminal helper",
            "body": "From the command line, ask the assistant to explain a failing run, suggest a fix or generate tests for a model. It reads the run log and the project together, so its answers point to the exact file and line that caused the problem in the first place.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Terminal output with a suggested fix",
              "ref": "/assets/features/feature-3.svg"
            }
          }
        ]
      },
      "motion": {
        "pattern": "tabs.instant",
        "reducedMotionFallback": "none-needed"
      },
      "style": {
        "strokeGradient": "gradient.01",
        "mediaFrame": "captioned",
        "mediaCorners": "square"
      }
    },
    {
      "section": "content.statement",
      "variant": "plain",
      "content": {
        "title": "Suggestions you can review, test and trust like any code",
        "body": "Every change the assistant proposes goes through the same review and checks as the rest of your work."
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-needed"
      },
      "style": {
        "width": "wide",
