    {
      "section": "features.card-grid",
      "variant": "inline-icon",
      "content": {
        "eyebrow": "Safe by design",
        "title": "Guardrails built into every suggestion",
        "body": "The assistant follows the same rules as the people using it, with no special access of its own.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/shield.svg"
            },
            "title": "Works inside your existing permissions model",
            "body": "The assistant can only read projects and environments you already have access to, and it never connects to production on its own."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/clipboard.svg"
            },
            "title": "Every action recorded in the audit log",
            "body": "Prompts, suggestions and accepted changes are logged, so administrators can review how the assistant is being used across teams."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/lock.svg"
            },
            "title": "Your code is not used to train shared models",
            "body": "Project code and data stay private to your organization and are never used to improve models offered to other customers."
          }
        ]
      },
