      "content": {
        "tabs": [
          {
            "label": "Metrics",
            "body": "Define customer-facing metrics once, review them like code and serve them to every tenant from one governed layer, with tests on each definition and access rules that travel with every request your application makes.",
            "media": {
              "assetRole": "product.screenshot",
              "alt": "Metric definition next to its monthly chart",
              "ref": "/assets/pages/tabs/light-5.svg"
            }
          },
          {
