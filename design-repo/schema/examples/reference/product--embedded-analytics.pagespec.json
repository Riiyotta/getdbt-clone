      "content": {
        "eyebrow": "Lattice for embedded analytics",
        "title": "Ship analytics your customers can trust.",
        "lead": "Serve fast, governed and consistent metrics inside the products your customers already use.",
        "primary": {
          "label": "Request your demo",
          "href": "/contact"
        },
        "secondary": {
          "label": "Explore Lattice for embedded analytics",
          "href": "/product/lattice"
        },
        "media": {
          "assetRole": "product.screenshot",
          "alt": "Embedded usage chart served to customer tenants",
          "ref": "/assets/pages/hero/embedded-analytics.svg"
        }
