    {
      "section": "features.checklist",
      "variant": "split",
      "content": {
        "title": "Embedded analytics, built right",
        "body": "When customers see numbers inside your product, they have to be right. Lattice gives product and data teams one tested, tenant-aware source for every metric.",
        "items": [
          {
            "title": "One definition",
            "body": "Every customer-facing metric is defined once, reviewed like code and served the same way in every chart and export."
          },
          {
            "title": "Access per tenant",
            "body": "Row-level rules travel with each metric, so a customer only sees the rows that belong to them."
          },
          {
            "title": "Tested first",
            "body": "Tests run on every build, so customers never see a broken chart or a figure that disagrees with your reports."
          }
        ],
        "image": {
          "assetRole": "photo.composite-scene",
          "alt": "An analyst checking a tenant revenue metric",
          "ref": "/assets/pages/split/embedded-analytics.svg"
        }
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "topPadding": "default",
        "imagePlacement": "right",
        "itemStyle": "headed"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "eyebrow": "Why us",
        "title": "Turn your data into a product feature customers will pay for.",
        "body": "Lattice lets product teams ship customer-facing analytics on the same governed foundation as internal reporting, so every chart is consistent, secure and fast enough to use every day. Metrics are defined once, reviewed like code and served through one API to whichever front end your team prefers.",
        "primary": {
          "label": "Talk to an expert",
          "href": "/contact"
        },
        "tertiary": {
          "label": "Explore Lattice for embedded analytics",
          "href": "/product/lattice"
        },
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/gauge.svg"
            },
            "title": "Fast at any scale, for every tenant",
            "body": "Cached, pre-aggregated metrics keep embedded charts responsive for every one of your tenants, even at the busiest times of day."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/lock.svg"
            },
            "title": "Secure by tenant",
            "body": "Access rules travel with each metric, so customers only ever see the data that belongs to them, and every request is checked."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/target.svg"
            },
            "title": "Consistent numbers inside and outside the product",
            "body": "The same definition powers internal reports and customer charts, ending awkward mismatches between what sales sees and what customers see in the product."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/plug.svg"
            },
            "title": "Any front end you choose",
            "body": "Serve metrics to your application through one API, whichever charting library or framework your front-end team prefers."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "revealTrigger": "scroll",
        "headerAlign": "start",
        "paddingTop": "default",
        "surface": "light",
        "columns": "4",
        "iconSize": "size.icon.32"
      }
    },
