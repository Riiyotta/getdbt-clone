    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "See it in action",
        "body": "Hear from teams who rebuilt how they ship data with us.",
        "stories": [
          {
            "name": "Tidepool",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Tidepool",
              "ref": "/assets/marquee/logo-3.svg"
            },
            "headline": "Tidepool gives product teams self-serve data they can trust",
            "quote": "Product managers wanted answers in hours, not tickets in a queue. Lattice gave them documented, tested models to build on, and our small data team finally spends its time on genuinely new questions instead of re-running old ones each week.",
            "person": "Ana Kowalski",
            "role": "Staff Data Engineer",
            "stats": [
              {
                "number": "70%",
                "label": "fewer ad hoc requests reaching the central data team"
              },
              {
                "number": "140",
                "label": "product dashboards rebuilt on certified, documented models"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies"
            }
          },
          {
            "name": "Orbitly",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Orbitly",
              "ref": "/assets/marquee/logo-5.svg"
            },
            "headline": "Orbitly cuts warehouse spend while shipping more models",
            "quote": "Our compute bill grew faster than the team. Reusing results for models whose inputs had not changed brought spend down in the first month, and the same project now serves twice as many teams across the company without a single new hire.",
            "person": "Jonah Reyes",
            "role": "VP, Data and Insights",
