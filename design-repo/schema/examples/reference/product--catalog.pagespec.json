    {
      "section": "social-proof.quote-band",
      "variant": "slider",
      "content": {
        "quotes": [
          {
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Tidepool",
              "ref": "/assets/marquee/logo-3.svg"
            },
            "quote": "Before the catalog, the fastest way to find a model was to ask whoever had been here longest. Now analysts search, check the owner and the test status, and reference the right model in minutes. New hires stopped building duplicate tables in their first month, and our documentation finally reflects what is actually running.",
            "person": "Ana Kowalski",
            "role": "Staff Data Engineer"
          },
          {
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Meridian Partners",
              "ref": "/assets/marquee/logo-2.svg"
            },
            "quote": "Column-level lineage changed how we review pull requests. Reviewers can see every report a change would touch before approving it, so surprises after a deploy have become rare. Auditors get the same view, which turned a week of evidence gathering into an afternoon of walking through the catalog together.",
            "person": "Tomas Ekberg",
            "role": "Director of Data Platforms"
          },
          {
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Orbitly",
