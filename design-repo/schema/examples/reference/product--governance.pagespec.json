        "columns": "6/6",
        "bottomPadding": "default"
      }
    },
    {
      "section": "features.card-grid",
      "variant": "plain-icon",
      "content": {
        "title": "Control that does not get in the way",
        "body": "Policies sit in the project beside the models they guard, which makes doing the right thing the simplest option for each builder.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/user.svg"
            },
            "title": "Clear ownership",
            "body": "Every model and metric has a named owner, so questions and incidents reach the right person on the first try."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/lock.svg"
            },
            "title": "Access that follows roles",
            "body": "Grant permissions by group and environment, and let them follow people automatically as they change teams."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "/assets/pages/icons/badge.svg"
            },
            "title": "Standards enforced in review",
            "body": "Contracts, required tests and naming rules are checked on every pull request before a change can merge."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "revealTrigger": "scroll",
        "headerAlign": "start",
        "paddingTop": "default",
        "surface": "light",
        "columns": "3",
        "iconSize": "size.icon.32"
