    {
      "section": "hero.split",
      "variant": "framed",
      "content": {
        "title": "Governance that keeps pace with your data team",
        "lead": "Set clear ownership, access rules and quality standards without slowing anyone down.",
        "primary": {
          "label": "Choose where to start today",
          "href": "#",
          "opensDialog": true
        },
        "secondary": {
          "label": "Talk to an expert",
          "href": "/contact"
        },
        "framed": {
          "assetRole": "product.screenshot",
          "alt": "Catalog search returning a certified revenue model and metric",
          "ref": "/assets/pages/hero/catalog.svg"
        }
      },
