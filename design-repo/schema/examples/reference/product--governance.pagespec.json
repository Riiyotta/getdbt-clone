    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "Governed at scale by leading teams",
        "body": "See how organizations with strict requirements keep their data both accessible and controlled.",
        "stories": [
          {
            "name": "Halcyon",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Halcyon",
              "ref": "/assets/marquee/logo-6.svg"
            },
            "headline": "Lineage on every regulated figure, ready for the next audit",
            "quote": "Auditors asked where each figure came from and we could simply show them the lineage, the tests and the approvals.",
            "person": "Grace Okafor",
            "role": "Chief Data Officer",
            "stats": [
              {
                "number": "0",
                "label": "audit findings on lineage or change control in the most recent external review of the project"
              },
              {
                "number": "100%",
                "label": "of regulated reports built on reviewed, tested and owned models with a clear audit trail"
              }
            ],
