    {
      "section": "hero.split",
      "variant": "flush",
      "content": {
        "title": "Build trusted analytics on Stratus.",
        "lead": "Lattice brings tested, documented and governed models to Stratus, so every team in your organization can work from the same definitions.",
        "primary": {
          "label": "Book your demo",
          "href": "/contact"
        },
        "secondary": {
          "label": "Start with Lattice + Stratus",
          "href": "/signup"
        },
        "media": {
          "assetRole": "photo.composite-scene",
          "alt": "Lattice and Stratus tiles around a data team at work",
          "ref": "/assets/pages/hero/stratus.svg"
        }
      },
