    {
      "section": "social-proof.customer-tabs",
      "variant": "default",
      "content": {
        "title": "Data teams trust Lattice + Stratus",
        "body": "Leading teams use Lattice with Stratus to lower the cost of insight, raise trust in data and ship work faster.",
        "stories": [
          {
            "name": "Meridian Partners",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Meridian Partners",
              "ref": "/assets/marquee/logo-2.svg"
            },
            "headline": "Meridian Partners standardizes reporting across eleven regional desks",
            "quote": "Every desk had its own version of assets under management. Now one tested definition feeds all eleven desks, and the quarterly close is a short review meeting instead of a week of firefighting.",
            "person": "Tomas Ekberg",
            "role": "Director of Data Platforms",
            "stats": [
              {
                "number": "Weeks to minutes",
                "label": "to close the quarterly books"
              },
              {
                "number": "11",
                "label": "regional desks reporting from one governed project"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies/meridian-partners"
            }
          },
          {
            "name": "Ferrocene",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Ferrocene",
              "ref": "/assets/marquee/logo-4.svg"
            },
            "headline": "Ferrocene brings plant and supply data into one tested project",
            "quote": "We were stitching sensor exports and supplier files together by hand before every planning cycle. Now the pipeline is versioned, every join is tested, and planners open a forecast they can trace all the way back to the original source rows.",
            "person": "Lukas Brenner",
            "role": "Manager, Operations Analytics",
            "stats": [
              {
                "number": "9",
                "label": "plants feeding a single, versioned and tested forecast"
              },
              {
                "number": "35%",
                "label": "less time preparing data before each planning cycle"
              }
            ],
            "action": {
              "label": "Read customer story",
              "href": "/case-studies"
            }
          },
          {
            "name": "Halcyon",
            "logo": {
              "assetRole": "customer.logo",
              "alt": "Halcyon",
              "ref": "/assets/marquee/logo-6.svg"
            },
            "headline": "Halcyon passes its audit with lineage on every regulated figure",
            "quote": "Auditors asked where each reported figure came from, and for the first time we could simply show them. Every model is versioned and tested, every change is reviewed, and lineage traces each number all the way back to the exact source rows it came from.",
            "person": "Grace Okafor",
            "role": "Chief Data Officer",
            "stats": [
              {
                "number": "0",
                "label": "audit findings on lineage or change control in the last review"
              },
