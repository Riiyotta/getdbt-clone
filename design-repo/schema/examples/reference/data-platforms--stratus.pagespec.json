    {
      "section": "features.card-grid",
      "variant": "image-card",
      "content": {
        "eyebrow": "Made for Stratus",
        "title": "Analytics engineering for every team working on Stratus.",
        "body": "Stratus brings your organization’s data into one place. Lattice gives the people who shape it a disciplined workflow, with code review, automated tests and generated documentation, so business users get reports they can rely on and engineers get a project they can maintain.",
        "cards": [
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-5.svg"
            },
            "title": "One version of the truth",
            "body": "Define metrics once and serve them to every report and workbook, so finance and operations stop arguing about numbers and start acting on them.",
            "action": {
              "label": "See how the semantic layer works",
              "href": "/product/semantic-layer"
            }
          },
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-6.svg"
            },
            "title": "Safer changes",
            "body": "Every change runs through review and tests in an isolated environment before it touches the reports people use every day.",
            "action": {
              "label": "See how testing works",
              "href": "/product/test-and-observe"
            }
          },
          {
            "image": {
              "assetRole": "photo.composite-scene",
              "alt": "",
              "ref": "/assets/pages/cards/card-7.svg"
            },
            "title": "Clear ownership",
            "body": "Owners, descriptions and lineage live next to the code, so anyone can see who to ask and what a change will affect.",
            "action": {
              "label": "See how the catalog works",
              "href": "/product/catalog"
            }
          }
        ]
      },
