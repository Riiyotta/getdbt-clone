      "content": {
        "title": "Bring the full modeling lifecycle to Stratus",
        "paragraphs": [
          "Lattice connects to Stratus so your team can design, test and ship models in one governed project, then keep them healthy in production."
        ],
        "bullets": [
          {
            "text": "Version every model and review each change before it ships"
          },
          {
            "text": "Test data in Stratus on every run, not once a quarter"
          },
          {
            "text": "Document models automatically as part of every build you run"
          },
          {
            "text": "Share certified models across every workspace"
          }
        ],
        "media": {
          "assetRole": "illustration.diagram",
