    {
      "section": "article.story-body",
      "variant": "default",
      "content": {
        "meta": {
          "logo": {
            "assetRole": "customer.placeholder-logo",
            "alt": "Tarnwick Foods",
            "ref": "generate:placeholder-logo-2"
          },
          "facts": [
            {
              "label": "projects shipped",
              "value": "Keep every project moving"
            },
            {
              "label": "hours saved each month",
              "value": "Share progress without another meeting"
            },
            {
              "label": "pages published",
              "value": "Join the conversation"
            },
            {
              "label": "uptime last year",
              "value": "Simple tools for careful work"
            }
          ]
        },
        "blocks": [
          {
            "kind": "h3",
            "text": "Clear ownership keeps handoffs short and questions easy to route."
          },
          {
            "kind": "p",
            "text": "Plain defaults get a new project running in an afternoon instead of a quarter. Reviewers see the same preview that readers will see, so surprises stay rare."
          },
          {
            "kind": "p",
            "text": "Built-in checks run on every change and report problems in words people can act on. Wrenly keeps a readable history, so you can always see who changed what and why."
          },
          {
            "kind": "p",
            "text": "Work moves forward without waiting on a single gatekeeper or a long approval chain. Small teams and large ones use the same tools, tuned to how each group already works."
          },
          {
            "kind": "p",
            "text": "Share a finished result with a colleague in one step and keep editing your own copy. You decide what is public, what is internal and what stays in draft. Each project carries its own notes, owners and a short list of things still to do."
          },
          {
            "kind": "h4",
            "text": "Move between drafts, previews and published pages without losing your place."
          }
        ]
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-needed"
      },
      "style": {
        "chapterLevel": "h3"
      }
