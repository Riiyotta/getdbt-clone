        "title": "Clear steps from first idea to finished page",
        "stats": [
          {
            "value": "52%",
            "label": "teams onboarded"
          },
          {
            "value": "400+",
            "label": "faster reviews"
          },
          {
            "value": "3.2x",
            "label": "fewer status meetings"
          }
        ],
        "quote": "Teams use one shared workspace so plans, checks and reviews stay in step. Every change is reviewed by a person before it reaches the people who depend on it.",
        "name": "Maren",
        "role": "Head of Operations"
      },
