    {
      "section": "features.checklist",
      "variant": "columns",
      "content": {
        "items": [
          {
            "title": "Shared work that stays in step",
            "body": "Clear ownership keeps handoffs short and questions easy to route. Plain defaults get a new project running in an afternoon instead of a quarter. Reviewers see the same preview that readers will see, so surprises stay rare."
          },
          {
            "title": "Review changes before anyone depends on them",
            "body": "Built-in checks run on every change and report problems in words people can act on."
          },
          {
            "title": "Practical help from people who care",
            "body": "Wrenly keeps a readable history, so you can always see who changed what and why. Work moves forward without waiting on a single gatekeeper or a long approval chain."
          },
          {
            "title": "Tools that stay out of your way",
            "body": "Small teams and large ones use the same tools, tuned to how each group already works. Share a finished result with a colleague in one step and keep editing your own copy."
          }
        ]
      },
      "motion": {
        "pattern": "reveal.fade-up",
        "reducedMotionFallback": "show-immediately"
      },
      "style": {
        "topPadding": "none",
        "imagePlacement": "right",
        "itemStyle": "headed"
      }
