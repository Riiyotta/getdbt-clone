      "content": {
        "title": "A friendlier path to reliable results",
        "body": "A quiet dashboard beats a loud one, so alerts only fire when somebody needs to act.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "generate:feature-7"
            },
            "title": "Open, readable and easy to audit",
            "body": "Our support group answers most questions within a working day and follows up until they are solved. Move between drafts, previews and published pages without losing your place."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "generate:feature-8"
            },
            "title": "Built to last through busy seasons",
            "body": "Guides, templates and worked examples help new teammates become productive in their first week. Choose the plan that fits today and change it later without a migration project."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "generate:feature-9"
            },
            "title": "Everything your team needs in one workspace",
            "body": "Access is granted by role, so people see what they need and nothing more. Teams report that planning meetings are shorter once the plan lives in one place."
          }
        ]
      },
