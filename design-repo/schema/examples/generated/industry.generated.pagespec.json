    {
      "section": "features.tabs-dark",
      "variant": "default",
      "content": {
        "title": "Clear steps from first idea to finished page",
        "body": "We publish the roadmap openly and update it every quarter with what shipped and what slipped. Customers can export their work at any time in open formats and take it elsewhere.",
        "tabs": [
          {
            "title": "One place for every plan and every review",
            "body": "Short feedback loops turn small improvements into steady progress over a season. The editor suggests the next step while you type and never changes anything on its own. Practical advice from people who run these projects every day, written without jargon.",
            "media": {
              "assetRole": "product.generated-visual",
              "alt": "Diagram of a plan moving through review to release",
              "ref": "generate:generated-visual-10"
            }
          },
          {
            "title": "Ready for the way your team works",
            "body": "A single sign-in covers the whole workspace, including guests who only need to read. Comments stay attached to the line they discuss, even after the page is edited.",
            "media": {
              "assetRole": "product.generated-visual",
              "alt": "Diagram of a plan moving through review to release",
              "ref": "generate:generated-visual-11"
            }
          },
          {
            "title": "Answers you can trust and trace",
            "body": "Schedules, owners and dependencies sit side by side so conflicts are caught early. Teams tell us the biggest change is how little time goes into status updates now.",
            "media": {
              "assetRole": "product.generated-visual",
              "alt": "Loop diagram of draft, review and publish",
              "ref": "generate:generated-visual-12"
            }
          },
          {
            "title": "A calmer way to run a busy project",
            "body": "Review the facts, share the plan and ship with confidence that nothing was missed. We keep the interface small on purpose so the important things are easy to find.",
            "media": {
              "assetRole": "product.generated-visual",
              "alt": "Dashboard with a progress chart and a task list",
              "ref": "generate:generated-visual-13"
            }
          },
          {
            "title": "Fewer handoffs and faster answers",
            "body": "Notes written once are reused everywhere they are relevant, which saves rewriting. Everyone gets the same fast experience on a laptop, a tablet or a phone.",
            "media": {
              "assetRole": "product.generated-visual",
              "alt": "Smiling team gathered around a shared screen",
              "ref": "generate:generated-visual-14"
            }
          }
        ]
      },
