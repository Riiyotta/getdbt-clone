      "variant": "square",
      "content": {
        "title": "Review changes before anyone depends on them",
        "lead": "Teams use one shared workspace so plans, checks and reviews stay in step. Every change is reviewed by a person before it reaches the people who depend on it.",
        "primary": {
          "label": "See how it works",
          "href": "/see-how-it-works-eda4"
        },
        "media": {
