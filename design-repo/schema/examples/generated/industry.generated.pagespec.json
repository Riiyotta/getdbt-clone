    {
      "section": "features.card-grid",
      "variant": "four-column",
      "content": {
        "eyebrow": "Know what changed and why",
        "title": "Simple tools for careful work",
        "body": "Start with a small project and grow it at the pace your team is comfortable with. Clear ownership keeps handoffs short and questions easy to route. Plain defaults get a new project running in an afternoon instead of a quarter.",
        "cards": [
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "generate:feature-2"
            },
            "title": "Join the conversation",
            "body": "Reviewers see the same preview that readers will see, so surprises stay rare. Built-in checks run on every change and report problems in words people can act on. Wrenly keeps a readable history, so you can always see who changed what and why."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "generate:feature-3"
            },
            "title": "Keep every project moving",
            "body": "Work moves forward without waiting on a single gatekeeper or a long approval chain. Small teams and large ones use the same tools, tuned to how each group already works."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "generate:feature-4"
            },
            "title": "Practical help from people who care",
            "body": "Share a finished result with a colleague in one step and keep editing your own copy. You decide what is public, what is internal and what stays in draft."
          },
          {
            "icon": {
              "assetRole": "icon.feature",
              "alt": "",
              "ref": "generate:feature-5"
            },
            "title": "Share progress without another meeting",
            "body": "Each project carries its own notes, owners and a short list of things still to do. Fewer meetings are needed when everyone can open the same page and see the same facts."
          }
        ]
      },
